# ============================================
# Deepseek 云端 API 配置（用于调用官方模型服务）
# ============================================

# 作用：Deepseek 官方 API 的身份验证密钥（相当于账号密码）
# 使用场景：每次调用 API 时，程序会在请求头中携带此密钥进行鉴权
# 获取方式：去 https://platform.deepseek.com/ 注册账号后申请
# 注意：示例中的 sk-xxx 是假的，必须替换成你自己的真实密钥
DEEPSEEK_API_KEY=sk-xxx

# 作用：Deepseek API 服务的入口地址
# 使用场景：程序拼接完整请求 URL 时使用（BASE_URL + /chat/completions 等）
# 注意：如果你使用官方服务，保持默认即可；如果是代理/网关，改成对应地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 作用：指定调用 Deepseek 的哪个模型
# 可选值：deepseek-v4-flash（通用对话，支持工具调用）、deepseek-v4-pro（推理版，不支持工具调用）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026.7.24 废弃，请使用新模型名
DEEPSEEK_MODEL=deepseek-v4-flash


# ============================================
# 视觉模型配置（用于图片解析和理解）
# ============================================

# 作用：视觉模型 API 的身份验证密钥
# 使用场景：处理图片解析、多模态理解等功能时使用
# 注意：替换为你的真实 API 密钥
VISION_API_KEY=sk-xxxx

# 作用：视觉模型 API 服务的入口地址
# 使用场景：程序拼接完整请求 URL 时使用
# 注意：根据实际使用的服务商进行配置
VISION_BASE_URL=https://ai.devtool.tech/proxy/v1

# 作用：指定调用哪个视觉模型
# 可选值：gpt-4o、gpt-4-vision-preview 等支持图片理解的模型
# 注意：需要确保所选模型具备视觉/多模态理解能力
VISION_MODEL=gpt-4o


# ============================================
# Ollama 本地模型配置（用于本地离线推理）
# ============================================

# 作用：Ollama 本地服务的访问地址和端口
# 使用场景：程序需要调用本地模型时，会向这个地址发送请求
# 默认值：http://localhost:11434（Ollama 安装后的默认监听地址）
# 注意：运行项目前，务必确保 Ollama 服务已启动（ollama serve 或桌面版开启）
OLLAMA_BASE_URL=http://192.168.110.131:11434

# 作用：指定用 Ollama 处理聊天任务时，调用哪个模型
# 可选值：任意已下载的模型，如 qwen2.5:7b、qwen2.5:32b、llama3.2:3b 等
# 注意：模型必须先用 ollama pull 模型名 下载到本地，否则会报错
OLLAMA_CHAT_MODEL=qwen2.5:32b

# 作用：指定用 Ollama 处理推理/思考任务时，调用哪个模型
# 可选值：deepseek-r1:7b、deepseek-r1:32b 等推理专用模型
# 注意：当 REASON_SERVICE=ollama 时，此配置生效
OLLAMA_REASON_MODEL=deepseek-r1:32b

# 作用：指定用 Ollama 处理 Agent 任务时，调用哪个模型
# 可选值：任意已下载的模型，如 qwen2.5:32b、llama3.2:3b 等
# 注意：当 AGENT_SERVICE=ollama 时，此配置生效
OLLAMA_AGENT_MODEL=qwen2.5:32b

# 作用：用于生成文本向量的 Ollama Embedding 模型
# 默认值：bge-m3（中文语义效果好，1024 维向量）
# 注意：需要先用 ollama pull bge-m3 下载模型
OLLAMA_EMBEDDING_MODEL=bge-m3


# ============================================
# 服务路由开关（决定用云端还是本地）
# ============================================

# 作用：决定聊天任务用哪个服务提供方
# 可选值：deepseek（云端 API）或 ollama（本地模型）
# 注意：选择哪个模型服务，就会加载对应哪个模型的 API Key、Base URL、Model 等配置
CHAT_SERVICE=deepseek

# 作用：决定推理/思考任务用哪个服务提供方
# 可选值：deepseek（云端 API）或 ollama（本地模型）
# 注意：如果选择 deepseek 模型服务，则需要将 DEEPSEEK_MODEL 设置为推理版模型
REASON_SERVICE=ollama

# 作用：决定 Agent 任务用哪个服务提供方
# 可选值：deepseek（云端 API）或 ollama（本地模型）
# 注意：Agent 任务通常需要较强的工具调用和规划能力
AGENT_SERVICE=deepseek


# ============================================
# SerpAPI 搜索增强配置（联网搜索功能）
# ============================================

# 作用：SerpAPI 密钥，用于调用搜索引擎获取实时信息
# 使用场景：联网检索功能，需要替换为真实密钥
# 获取方式：去 https://serpapi.com/ 注册账号后申请
# 注意：替换为你的真实 SerpAPI 密钥
SERPAPI_KEY=xxxxx

# 作用：联网搜索结果返回的数量
# 默认值：10
# 调整建议：数量越多结果越全面，但处理时间也更长
SEARCH_RESULT_COUNT=10


# ============================================
# 本地 MySQL 数据库配置（用于存储用户、对话、消息记录）
# ============================================

# 作用：MySQL 服务器地址
# 默认值：localhost（本机安装的 MySQL）
# 注意：根据实际环境修改，远程服务器填写 IP 地址
DB_HOST=localhost

# 作用：MySQL 服务端口，默认 3306
DB_PORT=3306

# 作用：数据库登录用户名
# 注意：替换为你实际的 MySQL 用户名
DB_USER=root

# 作用：数据库登录密码
# 注意：替换为你实际的 MySQL 密码
DB_PASSWORD=snowball2019

# 作用：使用的数据库名称
# 注意：启动前需要先在 MySQL 中创建这个库
DB_NAME=assist_gen


# ============================================
# 本地 Neo4j 图数据库配置（用于知识图谱存储）
# ============================================

# 作用：Neo4j 数据库的连接地址
# 默认值：bolt://localhost:7687（Neo4j 默认 Bolt 协议端口）
# 注意：需要确保 Neo4j 服务已启动
NEO4J_URL=bolt://localhost:7687

# 作用：Neo4j 登录用户名
# 默认值：neo4j
# 注意：替换为你实际的 Neo4j 用户名
NEO4J_USERNAME=neo4j

# 作用：Neo4j 登录密码
# 注意：替换为你实际的 Neo4j 密码
NEO4J_PASSWORD=Snowball2019

# 作用：Neo4j 使用的数据库名称
# 默认值：neo4j
# 注意：Neo4j 4.0+ 支持多数据库，如果不是默认库需要指定
NEO4J_DATABASE=neo4j


# ============================================
# Redis 缓存配置（用于语义缓存与向量检索）
# ============================================

# 作用：Redis 服务主机地址
# 默认值：localhost（本机 Redis）
REDIS_HOST=localhost

# 作用：Redis 服务端口，默认 6379
REDIS_PORT=6379

# 作用：Redis 数据库编号（0~15）
# 默认值：0
REDIS_DB=0

# 作用：Redis 密码（无密码则留空）
REDIS_PASSWORD=

# 作用：Redis 缓存过期时间（秒）
# 默认值：3600（即 1 小时）
# 调整建议：根据业务需求调整，频繁变化的数据设短一些
REDIS_CACHE_EXPIRE=3600

# 作用：Redis 语义缓存的命中阈值（0~1，越高越严格）
# 默认值：0.90 —— 向量余弦相似度 ≥ 0.90 时直接返回缓存结果
# 调整建议：追求准确度设 0.9+，追求命中率设 0.75+
REDIS_CACHE_THRESHOLD=0.90


# ============================================
# Microsoft GraphRAG 配置（用于知识图谱增强检索）
# ============================================

# 作用：GraphRAG 项目的根目录路径
# 默认值：{项目根目录}/app/graphrag（自动计算，无需配置）
# 注意：仅在需要自定义 GraphRAG 项目位置时设置此项，否则注释掉即可
# GRAPHRAG_PROJECT_DIR=/path/to/your/graphrag

# 作用：GraphRAG 数据目录名称（相对于项目目录）
# 默认值：data
# 注意：该目录下存放图谱索引文件和生成的社区报告
GRAPHRAG_DATA_DIR=data

# 作用：GraphRAG 查询类型
# 可选值：
#   - local：本地查询，基于实体关系和社区报告
#   - global：全局摘要查询，基于高层社区报告
#   - drift：漂移搜索，结合 local 和 global 的优势
#   - basic：基础文本搜索
# 注意：不同查询类型适用于不同的问答场景
GRAPHRAG_QUERY_TYPE=local

# 作用：GraphRAG 响应类型
# 默认值：text
# 注意：目前支持 text 格式返回
GRAPHRAG_RESPONSE_TYPE=text

# 作用：GraphRAG 社区层级（用于 global/drift 查询）
# 默认值：3
# 说明：层级越高，社区越抽象概括；层级越低，社区越具体细粒度
GRAPHRAG_COMMUNITY_LEVEL=3

# 作用：是否动态选择社区级别
# 默认值：false
# 说明：true 时根据查询动态选择合适的社区级别，false 时使用固定 COMMUNITY_LEVEL
GRAPHRAG_DYNAMIC_COMMUNITY=false

# ---- 以下为 settings.yaml 中 ${VAR} 占位符引用的环境变量 ----
# 作用：GraphRAG 索引构建时使用的 LLM API 地址
# 默认取 DEEPSEEK_BASE_URL，一般无需单独设置
# GRAPHRAG_API_BASE=

# 作用：GraphRAG 索引构建时使用的 LLM API 密钥
# 默认取 DEEPSEEK_API_KEY，一般无需单独设置
# GRAPHRAG_API_KEY=

# 作用：GraphRAG 索引构建时使用的 LLM 模型名
# 默认取 DEEPSEEK_MODEL，一般无需单独设置
# GRAPHRAG_MODEL_NAME=

# 作用：GraphRAG 索引构建时使用的 Embedding API 地址
# 默认取 DEEPSEEK_BASE_URL，如需单独指定可取消注释
# Embedding_API_BASE=

# 作用：GraphRAG 索引构建时使用的 Embedding API 密钥
# 默认取 DEEPSEEK_API_KEY，如需单独指定可取消注释
# Embedding_API_KEY=

# 作用：GraphRAG 索引构建时使用的 Embedding 模型名
# 默认值：text-embedding-3-small，如需更换可取消注释
# Embedding_MODEL_NAME=
